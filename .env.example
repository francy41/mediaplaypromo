# ────────────────────────────────────────────────────────────
# MediaPlayPromo — Environment Variables
# Copy this file to .env.local for local dev
# In Vercel: Settings → Environment Variables (Production)
# ────────────────────────────────────────────────────────────

# Supabase (REQUIRED)
# Get from: https://supabase.com/dashboard/project/osearkjjulupmznvkzaw/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://osearkjjulupmznvkzaw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role — NEVER commit. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL (for auth callbacks)
NEXT_PUBLIC_SITE_URL=https://mediaplaypromo.com

# ────────────────────────────────────────────────────────────
# Future integrations (add when ready)
# ────────────────────────────────────────────────────────────

# Stripe (pasarela de pago)
# Obtén las claves en: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...          (secreta, server)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   (pública, navegador)
# STRIPE_WEBHOOK_SECRET=whsec_...        (de Developers → Webhooks)

# PayPal
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Muapi.ai (image + video generation gateway)
# Obtén tu key en: https://muapi.ai/dashboard
# MUAPI_API_KEY=
# MUAPI_BASE_URL=https://api.muapi.ai

# OpenAI
# OPENAI_API_KEY=sk-...

# ElevenLabs
# ELEVENLABS_API_KEY=

# Resend (transactional emails)
# RESEND_API_KEY=
